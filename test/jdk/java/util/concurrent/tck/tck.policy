    permission au.zeus.jdk.authorization.guards.SerialObjectPermission "java.util.TreeMap$AscendingSubMap";
    permission au.zeus.jdk.authorization.guards.SerialObjectPermission "java.util.TreeMap$DescendingSubMap";
    permission au.zeus.jdk.authorization.guards.SerialObjectPermission "java.util.Collections$ReverseComparator";
    permission au.zeus.jdk.authorization.guards.SerialObjectPermission "java.lang.Boolean";
    permission au.zeus.jdk.authorization.guards.SerialObjectPermission "java.util.concurrent.locks.AbstractQueuedSynchronizer$ConditionObject";
    permission au.zeus.jdk.authorization.guards.SerialObjectPermission "PriorityQueueTest$MyReverseComparator";
