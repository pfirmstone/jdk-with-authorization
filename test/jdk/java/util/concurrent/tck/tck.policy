    permission au.zeus.jdk.authorization.guards.SerialObjectPermission "java.util.concurrent.atomic.AtomicBoolean";
    permission au.zeus.jdk.authorization.guards.SerialObjectPermission "java.util.concurrent.atomic.AtomicIntegerArray";
    permission au.zeus.jdk.authorization.guards.SerialObjectPermission "java.util.concurrent.atomic.AtomicInteger";
    permission au.zeus.jdk.authorization.guards.SerialObjectPermission "java.util.concurrent.atomic.AtomicLongArray";
    permission au.zeus.jdk.authorization.guards.SerialObjectPermission "java.util.concurrent.atomic.AtomicLong";
    permission au.zeus.jdk.authorization.guards.SerialObjectPermission "java.util.concurrent.atomic.AtomicReference";
    permission au.zeus.jdk.authorization.guards.SerialObjectPermission "java.util.concurrent.ConcurrentSkipListMap$SubMap";
    permission au.zeus.jdk.authorization.guards.SerialObjectPermission "java.util.concurrent.ConcurrentSkipListSet";
    permission au.zeus.jdk.authorization.guards.SerialObjectPermission "java.util.concurrent.locks.ReentrantReadWriteLock$NonfairSync";
    permission au.zeus.jdk.authorization.guards.SerialObjectPermission "java.util.concurrent.locks.ReentrantReadWriteLock$FairSync";
    permission au.zeus.jdk.authorization.guards.SerialObjectPermission "SemaphoreTest$PublicSemaphore";
    permission au.zeus.jdk.authorization.guards.SerialObjectPermission "java.util.concurrent.locks.ReentrantReadWriteLock$WriteLock";
